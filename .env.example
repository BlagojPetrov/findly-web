# Copy this file to .env.local and fill in the values.
# Supabase dashboard -> Project Settings -> API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public URL of the site, no trailing path (used for metadata, sitemap and auth
# redirects). On Vercel set it to the production URL; if it is missing there,
# the Vercel production domain is used.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
